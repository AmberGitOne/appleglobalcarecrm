# dependencies
node_modules/

# environment / secrets - never commit these
.env
.env.local
.env.*.local

# the database is generated by `npm run setup`
data/*.db
data/*.db-shm
data/*.db-wal

# build scratch
scripts/_seed_extract.js

# logs
*.log
npm-debug.log*

# editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Local development Postgres cluster (npm run db:local).
data/pgdata/

# Agent skills installed by `npx neon skills`. skills-lock.json is committed
# and is enough to reinstall them, the way package-lock.json is for
# node_modules - so the ~600K of vendored markdown stays out of the repo.
# Commit .claude/skills/ instead if you would rather a fresh clone have them
# without running anything.
.claude/skills/
.neon

# Written by the Vercel CLI: the project link (project and org ids) and a
# local copy of the deployment environment variables.
.vercel
