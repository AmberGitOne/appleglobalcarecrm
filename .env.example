# Copy this file to .env before running the app:
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)

PORT=4000
NODE_ENV=development

# SQLite file, relative to the project root. Created by `npm run setup`.
DB_FILE=./data/crm.db

# CHANGE THIS before deploying anywhere real.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

TOKEN_TTL=12h

# Set to true to require a bearer token or session cookie on every API route.
# Left false so the app opens straight into the CRM.
REQUIRE_AUTH=false
