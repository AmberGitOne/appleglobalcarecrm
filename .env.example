# Copy this file to .env before running the app:
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)

PORT=4000
NODE_ENV=development

# Postgres connection string. Required - there is no local-file fallback.
#
#   Vercel         the Postgres integration sets POSTGRES_URL for you
#   Anywhere else  put the connection string here as DATABASE_URL
#
# For a database on your own machine, with no cloud account:
#   npm run db:local      (leave it running; it prints this line)
DATABASE_URL=postgres://crm:crm@127.0.0.1:5433/crm

# A direct connection string, where the provider gives one alongside the
# pooled string above. Leave it unset and the app falls back to
# DATABASE_URL, which is right for a local server and wrong for Neon.
#
# Neon's pooled endpoint - the hostname with `-pooler` in it, which is the
# one to serve traffic through - is PgBouncer in transaction mode, so it
# does not keep a client on the same server connection between statements.
# The first-boot schema load takes an advisory lock, and through a pooler
# the lock and its unlock can land on different backends. Both Neon and the
# Vercel integration publish this next to the pooled one; the app also
# accepts Vercel's name for it, POSTGRES_URL_NON_POOLING.
DATABASE_URL_UNPOOLED=

# CHANGE THIS before deploying anywhere real.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

TOKEN_TTL=12h

# Set to true to require a bearer token or session cookie on every API route.
# Left false so the app opens straight into the CRM.
REQUIRE_AUTH=false

# Shows the demo account picker on the sign-in page, which publishes the
# seeded accounts' shared password. Defaults on outside production; keep it
# false anywhere the URL is reachable by somebody else.
DEMO_LOGIN=true

# The password the seeded accounts share. The default lives in the source
# and is therefore public, so under NODE_ENV=production the boot refuses to
# seed with it and stops with an explanation - set this to something of
# your own there.
#
# It has to be set BEFORE the first request, because that is what creates
# the accounts. Changing it afterwards does not change an existing
# password; re-seed, or set the password through the app.
DEMO_PASSWORD=
