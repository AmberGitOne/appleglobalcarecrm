# better-sqlite3 ships prebuilt binaries for win32, darwin and linux (x64 and
# arm64). npm would still try to rebuild it from source, because the package
# contains a binding.gyp and npm treats that as an implicit install script -
# which fails on any machine without Visual Studio / Xcode / build-essential.
#
# Skipping install scripts uses the bundled prebuild instead: no compiler
# needed, and the install drops from minutes to seconds. It is also the safer
# default, since no dependency gets to run arbitrary code at install time.
#
# If you ever add a dependency that genuinely needs to compile, install it
# once with:  npm install <pkg> --ignore-scripts=false
ignore-scripts=true
